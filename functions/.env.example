TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token

# Utilisez de préférence un Messaging Service Twilio.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Requis uniquement sans Messaging Service.
TWILIO_NUMBER=+10000000000
TWILIO_SENDER_ID=PARISFRET

# Facultatif : URL HTTPS recevant les statuts Twilio.
TWILIO_STATUS_CALLBACK_URL=

# Intégration serveur vers le service central de suivi.
# La clé elle-même doit être créée avec `firebase functions:secrets:set TRACKING_API_KEY`.
TRACKING_TENANT_ID=paris-fret-app
TRACKING_COMPANY_SLUG=paris-fret
TRACKING_API_URL=https://europe-west1-rdsgestion-b3ec6.cloudfunctions.net/trackingApi
